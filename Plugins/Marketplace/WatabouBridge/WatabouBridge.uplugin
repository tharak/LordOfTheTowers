{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.4.0",
	"FriendlyName": "Watabou Bridge",
	"Description": "Embed Watabou's procedural generators (Perilous Shores, City Generator, Village Generator, Dwellings, One Page Dungeon, Urban Places, Neighbourhood) directly in Unreal. Imports JSON output to UE assets and supports recursive seed chains across generators. Generator bundles are included with watabou's permission.",
	"Category": "PCG",
	"CreatedBy": "Timothé Lapetite",
	"CreatedByURL": "https://pcgex.gitbook.io/pcgex/watabou-bridge",
	"DocsURL": "https://pcgex.gitbook.io/pcgex/watabou-bridge",
	"MarketplaceURL": "",
	"SupportURL": "https://discord.gg/mde2vC5gbE",
	"EngineVersion": "5.8.0",
	"CanContainContent": false,
	"IsBetaVersion": true,
	"Installed": true,
